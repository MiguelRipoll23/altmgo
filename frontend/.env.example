# Copy to .env for `npm run dev`. Nothing needs setting on the Vercel project: the
# site and the API share an origin there and the calls stay relative.

# Origin of the API, no trailing slash. Set it only when the two are on different
# origins, which is the case locally — the API is on :3000 and vite is on :5173.
VITE_API_BASE_URL=http://localhost:3000
