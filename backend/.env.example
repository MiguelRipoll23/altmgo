# Copy to .env for `npm run dev` in this folder. The k3s Deployment gets the
# same two values from the mgo2-web-secrets secret instead.

# The game's Postgres. Inside the cluster this is the ordinary service URL, for
# example postgresql://user:password@mgo2-postgres:5432/mgo2
DATABASE_URL=postgresql://user:password@mgo2-postgres:5432/mgo2

# Signs this site's session tokens. Nothing outside this app verifies them, so it
# does not have to be the game server's secret — a value of its own is better.
JWT_SECRET=
