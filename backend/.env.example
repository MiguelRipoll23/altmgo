# Copy to .env for `vercel dev` — run from the repository root, not from here —
# and set the same ones on the Vercel project.

# Neon connection string. Use the pooled one; a serverless function opens a
# connection per invocation and the pooler is what keeps that affordable.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Signs this site's session tokens. Nothing outside this app verifies them, so it
# does not have to be the game server's secret — a value of its own is better.
JWT_SECRET=

# Bot token of the Discord application the manager writes official messages
# from. Optional: with it absent, the Discord message control is refused rather
# than failing halfway through a send. This is a token of *this* deployment; the
# game server holds one of its own for its slash commands, and publishing that
# one here would hand the bot to every signed-in moderator.
DISCORD_BOT_TOKEN=
