# Copy to .env for `vercel dev`, and set the same three on the Vercel project.

# Neon connection string. Use the pooled one; a serverless function opens a
# connection per invocation and the pooler is what keeps that affordable.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Must be the same value the game server signs with: it is the session-token key
# AND the key the host-link code is derived from.
JWT_SECRET=

# Address of the game server, host and port, no scheme. The health check asks it
# over http://.
SERVER_IP=45.13.22.10:80
